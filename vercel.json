{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/tedxtiet/:file(.*\\.[a-zA-Z0-9]+)",
      "destination": "/:file"
    },
    {
      "source": "/tedxtiet/:path*",
      "destination": "/tedxtiet.html"
    },
    {
      "source": "/tedxtiet",
      "destination": "/tedxtiet.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
